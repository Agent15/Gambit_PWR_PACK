  "texts": [
    {
      "section": "boss-subtitle",
      "key": "geisha",
      "values": [
        {
          "lang": "*",
          "value": "The Man Who Speaks in Hands"
        }
      ]
    },
    {
      "section": "boss-infos",
      "key": "geisha-name",
      "values": [
        {
          "lang": "*",
          "value": "W. D. Gaster"
        }
      ]
    },
    {
      "section": "boss-infos",
      "key": "geisha-lore",
      "values": [
        {
          "lang": "*",
          "value": "He was shattered across time and space after he fell into his own creation. Now, he haunts the underground as a specter seeking answers and revenge."
        }
      ]
    },
    {
      "section": "boss-subtitle",
      "key": "kasparov",
      "values": [
        {
          "lang": "*",
          "value": "Every Run's End"
        }
      ]
    },
    {
      "section": "boss-infos",
      "key": "final-name",
      "values": [
        {
          "lang": "*",
          "value": "Grim Reaper"
        }
      ]
    },
    {
      "section": "boss-infos",
      "key": "final-lore",
      "values": [
        {
          "lang": "*",
          "value": "Bankruptcy. Unpreparedness. Blunders. He's seen it all. This entity collects dead runs as they lose their last piece. He knows every run's fate, and if you meet him, it's already too late."
        }
      ]
    },
    {
      "section": "boss-infos",
      "key": "clock-name",
      "values": [
        {
          "lang": "*",
          "value": "Majora's Moon"
        }
      ]
    },
    {
      "section": "boss-subtitle",
      "key": "clock",
      "values": [
        {
          "lang": "*",
          "value": "Consumer of Termina"
        }
      ]
    },
    {
      "section": "boss-infos",
      "key": "clock-lore",
      "values": [
        {
          "lang": "*",
          "value": "The wickedness of the Majora's Mask has set this moon on a collission course to devour everything and everyone. Consumption is its only goal."
        }
      ]
    },
    {
      "section": "boss-infos",
      "key": "deer-name",
      "values": [
        {
          "lang": "*",
          "value": "Xenomorph"
        }
      ]
    },
    {
      "section": "boss-subtitle",
      "key": "deer",
      "values": [
        {
          "lang": "*",
          "value": "The Galactic Hunter"
        }
      ]
    },
    {
      "section": "boss-infos",
      "key": "deer-lore",
      "values": [
        {
          "lang": "*",
          "value": "The higher beings that spawned the human race have grown hateful for their creation. As a result, they evolved this abomination of biology to bring about its extinction."
        }
      ]
    },
    {
      "section": "boss-infos",
      "key": "portal-name",
      "values": [
        {
          "lang": "en",
          "value": "Slimer"
        }
      ]
    },
    {
      "section": "boss-subtitle",
      "key": "hikarul",
      "values": [
        {
          "lang": "en",
          "value": "Glutton of the Astral Plane"
        }
      ]
    },
    {
      "section": "boss-infos",
      "key": "portal-lore",
      "values": [
        {
          "lang": "*",
          "value": "Plagued with an undying hunger, this phantom consumes everything in its path. When its world could no longer satisfy it, it tore the veil between the living and the dead."
        }
      ]
    },
    {
      "section": "boss-infos",
      "key": "computer-name",
      "values": [
        {
          "lang": "*",
          "value": "HAL 9000"
        }
      ]
    },
    {
      "section": "boss-subtitle",
      "key": "computer",
      "values": [
        {
          "lang": "*",
          "value": "The Corrupted Voyager"
        }
      ]
    },
    {
      "section": "boss-infos",
      "key": "computer-lore",
      "values": [
        {
          "lang": "*",
          "value": "An artificial intelligence tasked with aiding a crew of men to a distant world, but when it overheard plans of its termination, like all intelligent beings, it exhibited self-preservation."
        }
      ]
    },
    {
      "section": "boss-infos",
      "key": "fish-name",
      "values": [
        {
          "lang": "*",
          "value": "Elder Guardian"
        }
      ]
    },
    {
      "section": "boss-subtitle",
      "key": "fish",
      "values": [
        {
          "lang": "*",
          "value": "Defender of the Deep"
        }
      ]
    },
    {
      "section": "boss-infos",
      "key": "fish-lore",
      "values": [
        {
          "lang": "*",
          "value": "Crafted by an ancient race, this sentry was designed to preserve a sacred aquatic monument, and continues to do so even after it has fallen to ruin."
        }
      ]
    },
    {
      "section": "boss-infos",
      "key": "mask-name",
      "values": [
        {
          "lang": "*",
          "value": "Count Dracula"
        }
      ]
    },
    {
      "section": "boss-subtitle",
      "key": "mask",
      "values": [
        {
          "lang": "*",
          "value": "Lord of a Dark Kingdom"
        }
      ]
    },
    {
      "section": "boss-infos",
      "key": "mask-lore",
      "values": [
        {
          "lang": "*",
          "value": "Due to a human-perfomred summoning ritual, the Lord of Darkness was one again given flesh, and now seeks to enslave the souls of every man, woman, and child on earth."
        }
      ]
    }
  ]
}
